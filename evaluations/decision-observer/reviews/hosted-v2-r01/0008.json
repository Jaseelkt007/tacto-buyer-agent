  "supporting_source": {
    "id": "message:sup:DEMO-C1:2",
    "kind": "conversation",
    "text": "{\"message_id\": \"msg:DEMO-C1-1-2\", \"from\": \"sales@DEMO-C1\", \"subject\": \"Re: Quote from Demo Machining Sp. z o.o.: New stainless pump shaft SH-220: award one of two suppliers\", \"body\": \"Dear partner,\\n\\nWe have reviewed your offer and can adjust our Angebot as follows. We appreciate your transparency regarding the competing offer. We checked the rival quote data you cited; it holds and we took it into account. \\n\\nPlease note that your requested terms for DAP delivery and 60 days payment significantly increase the overall cost. Our current Angebot stands at a price of €17.00 per unit, Zahlungsziel 60 days net, Lieferzeit 35 days, delivery DAP. \\n\\nTo offer you the best possible value, we propose maintaining EXW and 45 days payment, which allows us to lower our price to EUR 15.30 per unit. As an alternative at standard terms, we offer a price of €15.30 per unit, Zahlungsziel 45 days net, Lieferzeit 45 days, delivery EXW. Our offer remains valid for 30 days.\\n\\nBest regards\\nJoanna Kaczmarek\\nExport Manager, Demo Machining Sp. z o.o.\", \"refs\": [], \"action\": null, \"term_sheets\": [{\"term_sheet_id\": \"offer:DEMO-C1-1\", \"terms\": {\"unit_price\": 17.0, \"payment_days\": 60, \"lead_time_days\": 35, \"incoterm\": \"DAP\"}}, {\"term_sheet_id\": \"offer:DEMO-C1-1-a\", \"terms\": {\"unit_price\": 15.3, \"payment_days\": 45, \"lead_time_days\": 45, \"incoterm\": \"EXW\"}}], \"status\": \"open\", \"claim_results\": [{\"index\": 0, \"result\": \"verified\"}], \"missing_fields\": [], \"attachments\": []}"
  },
